{
  "collectCoverage": true,
  "coverageReporters": ["json-summary", "text"],
  "coverageThreshold": {
    "global": {
      "lines": 80
    }
  },
  "setupFilesAfterEnv": ["<rootDir>/src/tests/setup.js"],
  "maxWorkers": 1,
    "coveragePathIgnorePatterns": [
    "/node_modules/",
    "<rootDir>/src/metrics.js",
    "<rootDir>/src/logger.js"]

}
